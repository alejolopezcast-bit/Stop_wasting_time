<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Line icons as geometry, drawn on a 24 by 24 grid and stroked rather than filled, so one set
        works at any size and in any colour. Kept as data instead of an icon font: no dependency, and
        nothing to go missing on a machine that lacks the font.
    -->

    <!-- Navigation -->
    <Geometry x:Key="IconFocus">M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 8,12 A 4,4 0 1 1 16,12 A 4,4 0 1 1 8,12 Z</Geometry>
    <Geometry x:Key="IconUltra">M 13,2 L 5.5,13 L 11,13 L 9.5,22 L 18.5,10.5 L 12.5,10.5 Z</Geometry>
    <Geometry x:Key="IconBlock">M 12,2.5 L 19.5,5.8 V 11 C 19.5,15.8 16.3,19.9 12,21.5 C 7.7,19.9 4.5,15.8 4.5,11 V 5.8 Z M 9,9 L 15,15</Geometry>
    <Geometry x:Key="IconStats">M 5,20 V 13 M 12,20 V 4.5 M 19,20 V 9.5</Geometry>

    <!-- Statistics and status -->
    <Geometry x:Key="IconCheck">M 4.5,12.5 L 9.5,17.5 L 19.5,6.5</Geometry>
    <Geometry x:Key="IconClock">M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 12,6.5 V 12.3 L 16,14.6</Geometry>
    <Geometry x:Key="IconHourglass">M 7,3 H 17 M 7,21 H 17 M 8.5,3 V 7 L 12,12 L 8.5,17 V 21 M 15.5,3 V 7 L 12,12 L 15.5,17 V 21</Geometry>
    <Geometry x:Key="IconFlame">M 12,21.5 C 8.2,21.5 5.8,19.1 5.8,15.9 C 5.8,12.1 9,10.4 9.6,6.2 C 12.4,8.1 13.4,10.5 13.4,12.4 C 14.3,11.4 14.8,10 14.8,8.6 C 17.1,11 18.2,13.5 18.2,15.9 C 18.2,19.1 15.8,21.5 12,21.5 Z</Geometry>
    <Geometry x:Key="IconBan">M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 5.8,5.8 L 18.2,18.2</Geometry>
    <Geometry x:Key="IconCalendar">M 4,6.5 H 20 V 20 H 4 Z M 4,10.5 H 20 M 8,4 V 8 M 16,4 V 8</Geometry>

    <!-- Objects -->
    <Geometry x:Key="IconApp">M 3.5,5 H 20.5 V 19 H 3.5 Z M 3.5,9 H 20.5 M 6.5,7 H 6.6 M 9,7 H 9.1</Geometry>
    <Geometry x:Key="IconGlobe">M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 3.2,12 H 20.8 M 12,3 C 14.6,6.2 15.6,9.1 15.6,12 C 15.6,14.9 14.6,17.8 12,21 C 9.4,17.8 8.4,14.9 8.4,12 C 8.4,9.1 9.4,6.2 12,3 Z</Geometry>
    <Geometry x:Key="IconShieldCheck">M 12,2.5 L 19.5,5.8 V 11 C 19.5,15.8 16.3,19.9 12,21.5 C 7.7,19.9 4.5,15.8 4.5,11 V 5.8 Z M 8.8,11.8 L 11.2,14.2 L 15.4,9.6</Geometry>
    <Geometry x:Key="IconDatabase">M 12,3 C 16.4,3 20,4.3 20,6 C 20,7.7 16.4,9 12,9 C 7.6,9 4,7.7 4,6 C 4,4.3 7.6,3 12,3 Z M 4,6 V 18 C 4,19.7 7.6,21 12,21 C 16.4,21 20,19.7 20,18 V 6 M 4,12 C 4,13.7 7.6,15 12,15 C 16.4,15 20,13.7 20,12</Geometry>
    <Geometry x:Key="IconFolder">M 3.5,6.5 H 9.5 L 11.5,9 H 20.5 V 18.5 H 3.5 Z</Geometry>
    <Geometry x:Key="IconLock">M 6,11 H 18 V 20.5 H 6 Z M 8.8,11 V 7.6 A 3.2,3.2 0 0 1 15.2,7.6 V 11</Geometry>

    <!-- Actions -->
    <Geometry x:Key="IconPlus">M 12,5.5 V 18.5 M 5.5,12 H 18.5</Geometry>
    <Geometry x:Key="IconTrash">M 4.5,7 H 19.5 M 9.5,7 V 4.5 H 14.5 V 7 M 6.5,7 L 7.5,20 H 16.5 L 17.5,7</Geometry>
    <Geometry x:Key="IconRefresh">M 20,12 A 8,8 0 1 1 17.2,5.9 M 20.5,3.5 V 10 H 14</Geometry>
    <Geometry x:Key="IconPlay">M 8.5,5 L 19,12 L 8.5,19 Z</Geometry>

    <!-- Window caption, drawn on a 10 by 10 grid -->
    <Geometry x:Key="IconMinimize">M 0,5 H 10</Geometry>
    <Geometry x:Key="IconMaximize">M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z</Geometry>
    <Geometry x:Key="IconRestore">M 2.5,2.5 H 9.5 V 9.5 H 2.5 Z M 0.5,7.5 V 0.5 H 7.5</Geometry>
    <Geometry x:Key="IconClose">M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5</Geometry>

    <!--
        The shared look for an icon: a stroked path that inherits size and colour from where it is used.
        Every icon in the app goes through this, so weight and joins stay identical.
    -->
    <Style x:Key="IconStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SmallIconStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="StrokeThickness" Value="1.9" />
    </Style>

    <Style x:Key="CaptionIconStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

</ResourceDictionary>
