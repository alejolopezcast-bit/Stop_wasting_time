<Window x:Class="StopWastingTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infrastructure="clr-namespace:StopWastingTime.App.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=infrastructure:StartupReport}"
        Title="Stop Wasting Time"
        Icon="Assets/app.ico"
        Height="660"
        Width="640"
        MinHeight="560"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header. A Grid, not a StackPanel: the text column needs a bounded width to wrap. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Assets/app.ico" Width="52" Height="52" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Stop Wasting Time" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Style="{StaticResource SubtitleTextStyle}"
                           Margin="0,4,0,0"
                           Text="Bloqueá lo que te distrae mientras te concentrás, y mirá después cuántas veces lo lograste." />
            </StackPanel>
        </Grid>

        <!-- Startup status -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Estado del arranque" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="Permisos de administrador" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ElevationText}" Style="{StaticResource ValueTextStyle}" />
                    </StackPanel>

                    <Ellipse Grid.Row="1" Grid.Column="0" Width="8" Height="8" Margin="0,6,12,0"
                             VerticalAlignment="Top" Fill="{StaticResource SuccessBrush}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="Base de datos" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource ValueTextStyle}"
                                   ToolTip="{Binding DatabasePath}" />
                    </StackPanel>

                    <Ellipse Grid.Row="2" Grid.Column="0" Width="8" Height="8" Margin="0,6,12,0"
                             VerticalAlignment="Top" Fill="{StaticResource SuccessBrush}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="Lista de bloqueo" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding RulesText}" Style="{StaticResource ValueTextStyle}" />
                    </StackPanel>

                    <Ellipse Grid.Row="3" Grid.Column="0" Width="8" Height="8" Margin="0,6,12,0"
                             VerticalAlignment="Top" Fill="{StaticResource SuccessBrush}" />
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="Registro" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding LogPath}" Style="{StaticResource ValueTextStyle}"
                                   ToolTip="{Binding LogPath}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- What comes next -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Lo que falta" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,10,0,0"
                           Text="Esta versión arranca la app, prepara la base de datos y confirma que tiene los permisos que necesita. Las pantallas de sesión de concentración, lista de bloqueo y estadísticas llegan en los próximos pasos." />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abrir carpeta de datos"
                        Padding="14,8"
                        Click="OnOpenDataFolderClick" />
                <Button Content="Cerrar"
                        Margin="10,0,0,0"
                        Padding="14,8"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
