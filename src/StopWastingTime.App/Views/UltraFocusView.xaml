<UserControl x:Class="StopWastingTime.App.Views.UltraFocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:StopWastingTime.App.Controls"
             xmlns:viewModels="clr-namespace:StopWastingTime.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:UltraFocusViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="880">

    <Grid Style="{StaticResource PageRootStyle}" Margin="34,26,34,26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="286" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Enfoque ultra" Style="{StaticResource TitleTextStyle}" />
                <Border Background="{StaticResource UltraSoftBrush}"
                        CornerRadius="9"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="SIN SALIDA"
                               Foreground="{StaticResource UltraBrush}"
                               FontSize="10.5"
                               FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,4,0,0"
                       Text="Elegís el tiempo y no hay vuelta atrás: no se puede cancelar, la app no se cierra, y se bloquea toda tu lista." />
        </StackPanel>

        <!-- Timer -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="28">
            <StackPanel VerticalAlignment="Center">
                <Grid Width="268" Height="268" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="16" />

                    <controls:ProgressRing Fraction="{Binding ProgressFraction}"
                                           Thickness="16"
                                           Stroke="{StaticResource UltraGradientBrush}"
                                           StrokeThickness="16"
                                           StrokeStartLineCap="Round"
                                           StrokeEndLineCap="Round" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RemainingText}"
                                   Style="{StaticResource DisplayTextStyle}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Style="{StaticResource OverlineTextStyle}"
                                   Foreground="{StaticResource UltraBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Text="SIN CANCELACIÓN POSIBLE"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Style="{StaticResource OverlineTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Text="LISTO PARA COMPROMETERSE"
                                   Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}}" />

                        <Border Margin="0,14,0,0"
                                Padding="11,5"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                Background="{StaticResource UltraSoftBrush}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBan}" Style="{StaticResource SmallIconStyle}"
                                      Stroke="{StaticResource UltraBrush}" />
                                <TextBlock Text="{Binding BlockedDistractions}"
                                           Foreground="{StaticResource UltraBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="bloqueadas"
                                           Style="{StaticResource LabelTextStyle}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Duration -->
                <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0"
                            Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DurationPreset}">
                                <Button Content="{Binding Label}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Command="{Binding DataContext.SelectPresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{Binding IsSelected, Converter={StaticResource BoolToResource},
                                                             ConverterParameter=UltraSoftBrush|SurfaceSunkenBrush}"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToResource},
                                                              ConverterParameter=UltraBrush|BorderBrush}"
                                        Foreground="{Binding IsSelected, Converter={StaticResource BoolToResource},
                                                             ConverterParameter=UltraBrush|TextSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Text="{Binding SelectedMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="78"
                             TextAlignment="Center"
                             ToolTip="Minutos personalizados"
                             AutomationProperties.Name="Minutos ultra" />
                    <TextBlock Text="min" Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Action -->
                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Iniciar enfoque ultra"
                            Style="{StaticResource UltraButtonStyle}"
                            Command="{Binding StartCommand}"
                            Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}}" />

                    <Border Padding="20,13"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource UltraSoftBrush}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLock}" Style="{StaticResource SmallIconStyle}"
                                  Stroke="{StaticResource UltraBrush}" />
                            <TextBlock Text="Enfoque ultra en curso. Nos vemos cuando termine."
                                       Foreground="{StaticResource UltraBrush}"
                                       FontSize="13.5"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                           Text="{Binding Warning}"
                           Style="{StaticResource SubtitleTextStyle}"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Side panel: the terms -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,22,0,0">
            <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource UltraBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUltra}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource UltraBrush}" />
                        <TextBlock Text="ANTES DE EMPEZAR"
                                   Style="{StaticResource OverlineTextStyle}"
                                   Foreground="{StaticResource UltraBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Path Data="{StaticResource IconBan}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource LabelTextStyle}"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Width="195"
                                   Text="No hay botón de cancelar en ningún lado." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Path Data="{StaticResource IconLock}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource LabelTextStyle}"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Width="195"
                                   Text="Cerrar la ventana no termina la sesión, y salir de la app queda deshabilitado." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Path Data="{StaticResource IconBlock}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding BlocklistSummary}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Width="195" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="CUÁNDO USARLO" Style="{StaticResource OverlineTextStyle}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Text="Para lo que venís postergando hace días. Eleg&#237; un tiempo que puedas sostener: la única forma de salir antes es matar el proceso desde el Administrador de tareas." />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
