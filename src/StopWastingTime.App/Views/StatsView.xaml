<UserControl x:Class="StopWastingTime.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:StopWastingTime.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:StatsViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="880">

    <UserControl.Resources>
        <!-- A period chip lights up when its period is the one being shown. -->
        <Style x:Key="PeriodChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <Grid Margin="32,28,24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header and period picker -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Estadísticas" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Periods}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:PeriodChip}">
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource PeriodChipStyle}"
                                    Command="{Binding DataContext.SelectPeriodCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Headline numbers -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,20,0,0">
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Veces que te concentraste" Style="{StaticResource LabelTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource KpiValueTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Tiempo enfocado" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FocusedText}" Style="{StaticResource KpiValueTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Promedio por sesión" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource KpiValueTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Racha de días" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StreakText}" Style="{StaticResource KpiValueTextStyle}"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Distracciones bloqueadas" Style="{StaticResource LabelTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BlockedText}" Style="{StaticResource KpiValueTextStyle}"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bar chart -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource SectionTextStyle}" />

                    <ItemsControl ItemsSource="{Binding Bars}" Margin="0,18,0,0" Height="190">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ChartBar}">
                                <Grid Margin="2,0" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Rectangle Grid.Row="0"
                                               Height="{Binding Height}"
                                               MinHeight="3"
                                               VerticalAlignment="Bottom"
                                               RadiusX="4"
                                               RadiusY="4">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Opacity" Value="0.55" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Value}" Value="0">
                                                        <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Label}"
                                               Style="{StaticResource LabelTextStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Year heatmap -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Últimos 12 meses" Style="{StaticResource SectionTextStyle}" />
                    <TextBlock Text="Cada cuadradito es un día. Cuanto más marcado, más tiempo enfocado."
                               Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0" />

                    <ItemsControl ItemsSource="{Binding Heatmap}" Margin="0,14,0,0" Height="98">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:HeatmapCell}">
                                <Border Margin="1"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        Opacity="{Binding Opacity}"
                                        ToolTip="{Binding Tooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiller}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent sessions and what tempted you -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sesiones recientes" Style="{StaticResource SectionTextStyle}" />

                        <ItemsControl ItemsSource="{Binding RecentSessions}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:SessionRow}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding When}"
                                                   Style="{StaticResource ValueTextStyle}" />

                                        <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                                   Style="{StaticResource LabelTextStyle}"
                                                   Margin="0,0,16,0" />

                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource LabelTextStyle}"
                                   Text="Todavía no hay sesiones registradas en este período."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Lo que más te tentó" Style="{StaticResource SectionTextStyle}" />

                        <ItemsControl ItemsSource="{Binding TopDistractions}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:DistractionRow}">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ValueTextStyle}" />
                                        <TextBlock Text="{Binding HitsText}" Style="{StaticResource LabelTextStyle}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
