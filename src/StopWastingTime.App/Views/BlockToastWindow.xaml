<Window x:Class="StopWastingTime.App.Views.BlockToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop Wasting Time"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False">

    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText"
                           Text="Distracción bloqueada"
                           Style="{StaticResource ValueTextStyle}"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="DetailText"
                       Style="{StaticResource LabelTextStyle}"
                       TextWrapping="Wrap"
                       Margin="18,6,0,0" />
        </StackPanel>
    </Border>
</Window>
