<UserControl x:Class="StopWastingTime.App.Views.BlocklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:StopWastingTime.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:BlocklistViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="880">

    <UserControl.Resources>
        <!-- One row of either list: what it is, a switch, and a way off the list. -->
        <DataTemplate x:Key="RuleTemplate" DataType="{x:Type viewModels:BlockRuleViewModel}">
            <Border x:Name="Row"
                    Background="Transparent"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="10,9"
                    Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The real icon of the program when it could be read, its initial otherwise -->
                    <Grid Grid.Column="0" Width="32" Height="32">
                        <Border CornerRadius="{StaticResource RadiusSmall}"
                                Background="{StaticResource SurfaceOverlayBrush}">
                            <TextBlock Text="{Binding Initial}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}" Width="22" Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ValueTextStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource LabelTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding IsEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              AutomationProperties.Name="{Binding DisplayName}" />

                    <Button Grid.Column="3"
                            x:Name="RemoveButton"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center"
                            Opacity="0"
                            Command="{Binding DataContext.RemoveCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Quitar de la lista"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Quitar {0}'}">
                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource DangerBrush}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- The delete button only shows up when the row is under the pointer -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootStyle}" Margin="34,26,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock Text="Bloqueos" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,4,0,0"
                       Text="Lo que esté activado se bloquea mientras dure una sesión. Fuera de la sesión no se toca nada." />
        </StackPanel>

        <!-- Apps -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTileStyle}">
                            <Path Data="{StaticResource IconApp}" Style="{StaticResource SmallIconStyle}"
                                  Stroke="{StaticResource AccentBrightBrush}" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Apps" Style="{StaticResource SectionTextStyle}" />
                            <TextBlock Text="{Binding AppsCountText}" Style="{StaticResource LabelTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Add by name -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nombre del ejecutable, por ejemplo steam"
                                 AutomationProperties.Name="Nombre de la app" />
                        <TextBlock Text="Nombre del programa, por ejemplo steam"
                                   Style="{StaticResource LabelTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding NewAppName, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Command="{Binding AddAppCommand}"
                            AutomationProperties.Name="Agregar app"
                            ToolTip="Agregar a la lista">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource SmallIconStyle}"
                                  Stroke="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Agregar" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The list -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource RuleTemplate}" />
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasApps, Converter={StaticResource BoolToResource},
                                                     ConverterParameter=CollapsedVisibility|VisibleVisibility}">
                        <Path Data="{StaticResource IconApp}" Style="{StaticResource IconStyle}"
                              Width="30" Height="30" Stroke="{StaticResource TextTertiaryBrush}"
                              HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="Todavía no hay apps en la lista"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Running right now -->
                <Border Grid.Row="3" Style="{StaticResource InnerCardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ABIERTOS AHORA" Style="{StaticResource OverlineTextStyle}" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RefreshProcessesCommand}"
                                    ToolTip="Actualizar lista"
                                    AutomationProperties.Name="Actualizar lista">
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource SmallIconStyle}"
                                      Stroke="{StaticResource TextTertiaryBrush}" />
                            </Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding DetectedProcesses}"
                                 SelectedItem="{Binding SelectedProcess}"
                                 MaxHeight="92"
                                 Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:RunningProcessViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Agregar seleccionado"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddSelectedProcessCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Sites -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Style="{StaticResource IconTileStyle}">
                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource AccentBrightBrush}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sitios" Style="{StaticResource SectionTextStyle}" />
                        <TextBlock Text="{Binding SitesCountText}" Style="{StaticResource LabelTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding NewSiteDomain, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Dominio, por ejemplo instagram.com"
                                 AutomationProperties.Name="Dominio del sitio" />
                        <TextBlock Text="Dominio, por ejemplo instagram.com"
                                   Style="{StaticResource LabelTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding NewSiteDomain, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Command="{Binding AddSiteCommand}"
                            AutomationProperties.Name="Agregar sitio"
                            ToolTip="Agregar a la lista">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource SmallIconStyle}"
                                  Stroke="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Agregar" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sites}" ItemTemplate="{StaticResource RuleTemplate}" />
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSites, Converter={StaticResource BoolToResource},
                                                     ConverterParameter=CollapsedVisibility|VisibleVisibility}">
                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconStyle}"
                              Width="30" Height="30" Stroke="{StaticResource TextTertiaryBrush}"
                              HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="Todavía no hay sitios en la lista"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource InnerCardStyle}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource SmallIconStyle}"
                              Stroke="{StaticResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Text="Se bloquea el dominio, no el navegador: podés seguir trabajando con el resto de la web." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                   Text="{Binding Error}"
                   Style="{StaticResource LabelTextStyle}"
                   Foreground="{StaticResource DangerBrush}"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,-20" />
    </Grid>
</UserControl>
