<UserControl x:Class="StopWastingTime.App.Controls.LanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StopWastingTime.App.Controls"
             xmlns:loc="clr-namespace:StopWastingTime.App.Localization"
             AutomationProperties.Name="{loc:Tr Language_Title}">

    <!-- A segmented control: every language side by side, the current one lit. -->
    <Border Background="{StaticResource SurfaceSunkenBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSmall}"
            Padding="3">
        <ItemsControl ItemsSource="{Binding Languages, Source={x:Static loc:Localizer.Instance}}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type loc:LanguageOption}">
                    <Button Command="{Binding SelectLanguageCommand, Source={x:Static loc:Localizer.Instance}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="{Binding NativeName}"
                            AutomationProperties.Name="{Binding NativeName}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        Background="{Binding IsSelected, Converter={StaticResource BoolToResource},
                                                             ConverterParameter=AccentSoftBrush|TransparentBrush}">
                                    <TextBlock x:Name="Caption"
                                               Text="{Binding NativeName}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding IsSelected, Converter={StaticResource BoolToResource},
                                                                    ConverterParameter=AccentBrightBrush|TextSecondaryBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Where the language is chosen once and seldom again, a code is enough -->
                                    <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=controls:LanguagePicker}}"
                                                 Value="True">
                                        <Setter TargetName="Caption" Property="Text" Value="{Binding ShortName}" />
                                        <Setter TargetName="Chrome" Property="Padding" Value="9,4" />
                                    </DataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                        <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
