<UserControl x:Class="StopWastingTime.App.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:loc="clr-namespace:StopWastingTime.App.Localization"
             Height="44">

    <UserControl.Resources>
        <!-- A caption button: square, quiet until you point at it, red only for close. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E03A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="../Assets/logo.png" Width="18" Height="18" />
            <TextBlock x:Name="TitleText"
                       Text="Stop Wasting Time"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12.5"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Middle: what the window is doing right now, when it is doing something -->
        <ContentPresenter Grid.Column="1" Content="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="OnMinimizeClick"
                    ToolTip="{loc:Tr Caption_Minimize}"
                    AutomationProperties.Name="{loc:Tr Caption_Minimize}">
                <Path Data="{StaticResource IconMinimize}" Style="{StaticResource CaptionIconStyle}" />
            </Button>

            <Button x:Name="MaximizeButton"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="OnMaximizeClick"
                    ToolTip="{loc:Tr Caption_Maximize}"
                    AutomationProperties.Name="{loc:Tr Caption_Maximize}">
                <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource CaptionIconStyle}" />
            </Button>

            <Button Style="{StaticResource CloseButtonStyle}"
                    Click="OnCloseClick"
                    ToolTip="{loc:Tr Caption_Close}"
                    AutomationProperties.Name="{loc:Tr Caption_Close}">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource CaptionIconStyle}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
